# Public product values. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SERVICE_NAME=Pnlwise
NEXT_PUBLIC_SITE_URL=https://example.invalid
NEXT_PUBLIC_REPORT_PRICE_CENTS=1299
NEXT_PUBLIC_REPORT_RETENTION_DAYS=30
NEXT_PUBLIC_HIGH_CONFIDENCE=0.85
NEXT_PUBLIC_REVIEW_CONFIDENCE=0.70

# Runtime configuration. Leave integration secrets empty for the working preview.
APP_ORIGIN=
# Keep true/default on HTTPS hosting; false is only for local production-mode tests.
COOKIE_SECURE=
# Required before checkout is enabled. Configure verified operational values.
LEGAL_OPERATOR_NAME=
SUPPORT_EMAIL=
# Paddle Sandbox only. Live Paddle keys and tokens are rejected.
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Legacy Stripe Test Mode remains available for rollback; it is not the active checkout path.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
# Responses API model that supports Structured Outputs.
OPENAI_MODEL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MAINTENANCE_SECRET=
SENTRY_DSN=
